  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "D5 Debug",
      "sourceLanguages": [
        "rust"
      ],
      "cargo": {
        "args": [
          "build",
          "--bin=d5",
          "--package=d5",
          "--manifest-path=${workspaceFolder}/d5/Cargo.toml"
        ],
        "filter": {
          "name": "d5",
          "kind": "bin"
        }
      },
      "args": [
        "input.txt"
      ],
      "cwd": "${workspaceFolder}/d5"
    },
  ]
}